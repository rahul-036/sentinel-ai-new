# Application identity
APP_NAME="Sentinel AI"
APP_ENV=local
DEBUG=true

# URL prefix for all v1 routes
API_V1_PREFIX=/api/v1

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# REQUIRED — must be a PostgreSQL connection string (postgresql+asyncpg://...)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# WeatherAPI.com key — get a free key at https://www.weatherapi.com/
# If left empty the agent falls back to mock weather data (no crash)
WEATHER_API_KEY=

# OpenRouteService key — get a free key at https://openrouteservice.org/
# If left empty POST /api/v1/route/analyze returns HTTP 503
OPENROUTESERVICE_API_KEY=

# JSON list of allowed CORS origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log format: console (human-readable) | json (structured)
LOG_FORMAT=console
